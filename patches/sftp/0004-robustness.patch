diff -ruN a/request.go b/request.go
--- a/request.go	2026-10-02 22:07:37.989644104 +0200
+++ b/request.go	2026-10-02 22:16:29.708925353 +0200
@@ -337,6 +337,23 @@
 
 // called from worker to handle packet/request
 func (r *Request) call(handlers Handlers, pkt requestPacket, alloc *allocator, orderID uint32, maxTxPacket uint32) responsePacket {
+	// A handle only serves the packets of what it was opened for: otherwise a READ on a
+	// write-only handle would write its zeroed buffer, and a READ on a directory consume entries.
+	var allowed bool
+	switch pkt.(type) {
+	case *sshFxpReadPacket:
+		allowed = r.Method == "Get" || r.Method == "Open"
+	case *sshFxpWritePacket:
+		allowed = r.Method == "Put" || r.Method == "Open"
+	case *sshFxpReaddirPacket:
+		allowed = r.Method == "List"
+	default:
+		allowed = true
+	}
+	if !allowed {
+		return statusFromError(pkt.id(), EBADF)
+	}
+
 	switch r.Method {
 	case "Get":
 		return fileget(handlers.FileGet, r, pkt, alloc, orderID, maxTxPacket)
