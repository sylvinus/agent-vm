+// sshfs sends the mode of mkdir(2) as MKDIR attributes.
+func TestRequestMkdirAttributes(t *testing.T) {
+	var b []byte
+	b = marshalUint32(b, 1)
+	b = marshalString(b, "/d")
+	b = marshalUint32(b, sshFileXferAttrPermissions)
+	b = marshalUint32(b, 0o700)
+	p := &sshFxpMkdirPacket{}
+	require.NoError(t, p.UnmarshalBinary(b))
+	r := requestFromPacket(context.Background(), p, "/")
+	assert.Equal(t, "Mkdir", r.Method)
+	assert.True(t, r.AttrFlags().Permissions)
+	require.NotNil(t, r.Attributes())
+	assert.Equal(t, uint32(0o700), r.Attributes().Mode)
+}
