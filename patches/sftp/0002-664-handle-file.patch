diff -ruN a/request-server_test.go b/request-server_test.go
--- a/request-server_test.go	2026-10-02 20:30:47.822648126 +0200
+++ b/request-server_test.go	2026-10-02 20:30:47.818642830 +0200
@@ -1045,3 +1045,47 @@
 		cleanPath(bslash+"a"+bslash+bslash+"b"+bslash+bslash+"c"+bslash))
 	assert.Equal(t, "/C:/a", cleanPath("C:"+bslash+"a"))
 }
+
+type handleFileRecorder struct {
+	FileLister
+	FileCmder
+	got []any
+}
+
+func (h *handleFileRecorder) Filelist(r *Request) (ListerAt, error) {
+	if r.Method == "Stat" {
+		h.got = append(h.got, r.HandleFile())
+	}
+	return h.FileLister.Filelist(r)
+}
+
+func (h *handleFileRecorder) Filecmd(r *Request) error {
+	if r.Method == "Setstat" {
+		h.got = append(h.got, r.HandleFile())
+	}
+	return h.FileCmder.Filecmd(r)
+}
+
+func TestRequestHandleFile(t *testing.T) {
+	mem := InMemHandler()
+	rec := &handleFileRecorder{FileLister: mem.FileList, FileCmder: mem.FileCmd}
+	p := clientRequestServerPairWithHandlers(t, Handlers{FileGet: mem.FileGet, FilePut: mem.FilePut, FileCmd: rec, FileList: rec})
+	defer p.Close()
+
+	f, err := p.cli.Create("/a")
+	require.NoError(t, err)
+	defer f.Close()
+	_, err = f.Stat()
+	require.NoError(t, err)
+	require.NoError(t, f.Truncate(0))
+	_, err = p.cli.Stat("/a")
+	require.NoError(t, err)
+	require.NoError(t, p.cli.Truncate("/a", 0))
+
+	require.Len(t, rec.got, 4)
+	assert.NotNil(t, rec.got[0], "FSTAT")
+	assert.NotNil(t, rec.got[1], "FSETSTAT")
+	assert.Same(t, rec.got[0], rec.got[1])
+	assert.Nil(t, rec.got[2], "STAT")
+	assert.Nil(t, rec.got[3], "SETSTAT")
+}
