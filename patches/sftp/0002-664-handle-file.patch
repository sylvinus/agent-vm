+// HandleFile returns, for the Stat request of a FSTAT and the Setstat request of a FSETSTAT,
+// what the handlers returned when the handle was opened: the io.ReaderAt, io.WriterAt,
+// WriterAtReaderAt or ListerAt. It returns nil for other requests.
+//
+// Filepath is the path the handle was opened with, which may now be another file,
+// or none, if the file was renamed or removed since. Handlers that can should act
+// on the returned value instead.
+func (r *Request) HandleFile() any {
+	return r.handleFile
+}
+
+// opened returns what the handlers returned when r was opened, or nil.
+func (s *state) opened() any {
+	rd, wr, rw := s.getAllReaderWriters()
+	switch {
+	case rw != nil:
+		return rw
+	case wr != nil:
+		return wr
+	case rd != nil:
+		return rd
+	}
+	if la := s.getListerAt(); la != nil {
+		return la
+	}
+	return nil
+}
