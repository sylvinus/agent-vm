Subject: [PATCH] tap: a connection closed by the program's cancel is not an error

Switch.Accept logs "cannot receive packets from X, disconnecting" at error
level, and returns the error, when the connection's read fails. A program
that stops its switch by cancelling the context and closing the connection
gets that error each time, though it asked for it. Accept returns nil then,
and says nothing.

Test: TestAcceptEndedByContext (a read failing by itself is still an error).

---
diff --git a/pkg/tap/switch.go b/pkg/tap/switch.go
index 944b618f..e96a0fd9 100644
--- a/pkg/tap/switch.go
+++ b/pkg/tap/switch.go
@@ -96,6 +96,10 @@ func (e *Switch) Accept(ctx context.Context, rawConn net.Conn, protocol types.Pr
 		e.disconnect(id, conn)
 	}()
 	if err := e.rx(ctx, id, conn); err != nil {
+		if ctx.Err() != nil {
+			// Closing the connection is how a program ends the switch.
+			return nil
+		}
 		err := fmt.Errorf("cannot receive packets from %s, disconnecting: %w", conn.RemoteAddr().String(), err)
 		log.Error(err)
 		return err
diff --git a/pkg/tap/switch_test.go b/pkg/tap/switch_test.go
new file mode 100644
index 00000000..4039fe9b
--- /dev/null
+++ b/pkg/tap/switch_test.go
@@ -0,0 +1,48 @@
+package tap
+
+import (
+	"context"
+	"net"
+	"sync"
+	"testing"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+	"github.com/stretchr/testify/require"
+)
+
+// readingConn says when it is first read.
+type readingConn struct {
+	net.Conn
+	reading chan struct{}
+	once    sync.Once
+}
+
+func (c *readingConn) Read(b []byte) (int, error) {
+	c.once.Do(func() { close(c.reading) })
+	return c.Conn.Read(b)
+}
+
+// A connection that ends because the program cancelled the context is not an
+// error; one that ends by itself is.
+func TestAcceptEndedByContext(t *testing.T) {
+	for _, cancelled := range []bool{true, false} {
+		s := NewSwitch(false)
+		ours, theirs := net.Pipe()
+		conn := &readingConn{Conn: ours, reading: make(chan struct{})}
+		ctx, cancel := context.WithCancel(context.Background())
+		done := make(chan error, 1)
+		go func() { done <- s.Accept(ctx, conn, types.VfkitProtocol) }()
+		<-conn.reading
+		if cancelled {
+			cancel()
+		}
+		theirs.Close()
+		err := <-done
+		cancel()
+		if cancelled {
+			require.NoError(t, err)
+		} else {
+			require.Error(t, err)
+		}
+	}
+}
