@@ -196,6 +212,7 @@ func (rsf *ReverseSSHFS) Start() error {
 			WriteCloser: stdinPipe,
 		}
 		builtinSftpServer, rooted, err = newRootedServer(stdio, rsf.LocalPath, rsf.Readonly, rsf.ReadonlyNames)
+		rsf.rooted.Store(rooted)
 		if err != nil {
 			return err
 		}
