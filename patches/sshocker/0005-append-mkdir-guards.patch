+// The host grows the file after the client learned its size: an append must not overwrite that.
+func TestRootedAppendAfterHostWrite(t *testing.T) {
+	c, root := setupRooted(t, false)
+	p := filepath.Join(root, "src", "main.go")
+	f, err := c.OpenFile(p, os.O_WRONLY|os.O_APPEND)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if _, err := f.WriteAt([]byte("-guest1"), 4); err != nil {
+		t.Fatal(err)
+	}
+	hf, err := os.OpenFile(p, os.O_WRONLY|os.O_APPEND, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := hf.WriteString("-host"); err != nil {
+		t.Fatal(err)
+	}
+	hf.Close()
+	if _, err := f.WriteAt([]byte("-guest2"), 11); err != nil {
+		t.Fatal(err)
+	}
+	if b, err := os.ReadFile(p); err != nil || string(b) != "orig-guest1-host-guest2" {
+		t.Fatalf("%q, %v", b, err)
+	}
+}
+
+// Attributes shorter than their flags announce: an error, not a panic of the process serving the mount.
+func TestRootedSetstatShortAttributes(t *testing.T) {
+	_, root, h := setupRootedHandlers(t, false)
+	for _, rel := range []string{"src/main.go", ".git/config"} {
+		for _, flags := range []uint32{0x1, 0x2, 0x4, 0x8} {
+			r := sftp.NewRequest("Setstat", filepath.Join(root, rel))
+			r.Flags = flags
+			if err := h.Filecmd(r); err == nil {
+				t.Fatalf("%s, flags %#x: no error", rel, flags)
+			}
+		}
+	}
+	r := sftp.NewRequest("Mkdir", filepath.Join(root, "src", "dir"))
+	r.Flags = 0x4
+	if err := h.Filecmd(r); err != nil {
+		t.Fatal(err)
+	}
+	assertUnchanged(t, root)
+}
