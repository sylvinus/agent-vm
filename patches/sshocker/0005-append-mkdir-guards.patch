+// appendWrite writes b at the end of f, as it is when the write happens.
+func appendWrite(f *os.File, b []byte) (int, error) {
+	var n uint32
+	// Offset and OffsetHigh both 0xFFFFFFFF: write to the end of the file (WriteFile documentation).
+	ov := windows.Overlapped{Offset: 0xFFFFFFFF, OffsetHigh: 0xFFFFFFFF}
