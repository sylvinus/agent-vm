+// A handle opened for reading may point into a read-only name through a symlink:
+// FSETSTAT on it must keep going through the path checks.
+func TestRootedFsetstatReadHandle(t *testing.T) {
+	c, root := setupRooted(t, false)
+	f, err := c.Open(filepath.Join(root, "configlink"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if err := f.Truncate(0); err == nil {
+		t.Fatal("Truncate succeeded")
+	}
+	if err := f.Chmod(0o777); err == nil {
+		t.Fatal("Chmod succeeded")
+	}
+	assertUnchanged(t, root)
+}
