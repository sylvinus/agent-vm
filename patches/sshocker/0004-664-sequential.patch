+// fsetstat applies a FSETSTAT to the file f of the handle.
+func (h *rootedHandlers) fsetstat(f *os.File, r *sftp.Request) error {
+	if r.AttrFlags().UidGid {
+		return &os.PathError{Op: "chown", Path: f.Name(), Err: syscall.EWINDOWS}
+	}
+	return setstatHandle(windows.Handle(f.Fd()), r)
+}
+
+// setstatHandle applies the attributes of r to fh. r.Filepath is only used in errors.
+
+func setstatHandle(fh windows.Handle, r *sftp.Request) error {
+	flags := r.AttrFlags()
+	attrs := r.Attributes()
+	if attrs == nil {
+		return windows.ERROR_INVALID_PARAMETER
+	}
 	if flags.Size {
 		if err := windows.Ftruncate(fh, int64(attrs.Size)); err != nil {
 			return &os.PathError{Op: "truncate", Path: r.Filepath, Err: err}
