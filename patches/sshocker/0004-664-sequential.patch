+// FSTAT and FSETSTAT apply to the open file, not to whatever is now at the path it was opened with.
+func TestRootedFstatFsetstatAfterRename(t *testing.T) {
+	c, root := setupRooted(t, false)
+	p := func(s string) string { return filepath.Join(root, s) }
+	f, err := c.Create(p("src/a"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if _, err := f.Write([]byte("hello")); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.PosixRename(p("src/a"), p("src/b")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p("src/a"), []byte("other file"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if fi, err := f.Stat(); err != nil || fi.Size() != 5 {
+		t.Fatalf("Stat: %v, %v", fi, err)
+	}
+	if err := f.Truncate(2); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Chmod(0o600); err != nil {
+		t.Fatal(err)
+	}
+	if b, err := os.ReadFile(p("src/b")); err != nil || string(b) != "he" {
+		t.Fatalf("src/b: %q, %v", b, err)
+	}
+	if b, err := os.ReadFile(p("src/a")); err != nil || string(b) != "other file" {
+		t.Fatalf("src/a: %q, %v", b, err)
+	}
+	if runtime.GOOS != "windows" {
+		if fi, err := os.Stat(p("src/b")); err != nil || fi.Mode().Perm() != 0o600 {
+			t.Fatalf("src/b: %v, %v", fi, err)
+		}
+		if fi, err := os.Stat(p("src/a")); err != nil || fi.Mode().Perm() != 0o644 {
+			t.Fatalf("src/a: %v, %v", fi, err)
+		}
+	}
+}
