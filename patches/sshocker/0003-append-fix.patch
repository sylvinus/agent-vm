+// sshfs sends its open flags with the permissions alone as attributes.
+func TestRootedOpenMode(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("mode bits other than the owner write bit are not supported on Windows")
+	}
+	_, root, h := setupRootedHandlers(t, false)
+	const write, appendFlag, creat = 0x2, 0x4, 0x8
+	r := sftp.NewRequest("Put", filepath.Join(root, "src", "run.sh"))
+	r.Flags = write | appendFlag | creat
+	r.Attrs = []byte{0, 0, 0o1, 0o355} // 0o755
+	f, err := h.openFile(r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.Close()
+	if fi, err := os.Stat(filepath.Join(root, "src", "run.sh")); err != nil || fi.Mode().Perm() != 0o755 {
+		t.Fatalf("%v, %v", fi, err)
+	}
+}
