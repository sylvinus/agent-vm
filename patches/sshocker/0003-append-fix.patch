+// SSH_FXF_APPEND has the bit of SSH_FILEXFER_ATTR_PERMISSIONS: an append open used to
+// panic the server, and with it the process serving the mount.
+func TestRootedOpenAppend(t *testing.T) {
+	c, root := setupRooted(t, false)
+	for _, s := range []string{"src/main.go", "src/new.go"} {
+		f, err := c.OpenFile(filepath.Join(root, s), os.O_WRONLY|os.O_APPEND|os.O_CREATE)
+		if err != nil {
+			t.Fatalf("%s: %v", s, err)
+		}
+		// The server ignores SSH_FXF_APPEND: the client sends the offset, as sshfs does.
+		if _, err := f.Seek(0, io.SeekEnd); err != nil {
+			t.Fatalf("%s: %v", s, err)
+		}
+		if _, err := f.Write([]byte("+")); err != nil {
+			t.Fatalf("%s: %v", s, err)
+		}
+		f.Close()
+	}
+	for s, want := range map[string]string{"src/main.go": "orig+", "src/new.go": "+"} {
+		if b, err := os.ReadFile(filepath.Join(root, s)); err != nil || string(b) != want {
+			t.Fatalf("%s: %q, %v", s, b, err)
+		}
+	}
+}
