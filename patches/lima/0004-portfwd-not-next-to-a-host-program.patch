+// has reports whether the forward of hostAddress to guestAddress is open.
+func (p *ClosableListeners) has(protocol, hostAddress, guestAddress string) bool {
+	k := key(protocol, hostAddress, guestAddress)
+	if protocol == "udp" {
+		p.udpListenersRW.Lock()
+		defer p.udpListenersRW.Unlock()
+		_, ok := p.udpListeners[k]
+		return ok
+	}
+	p.listenersRW.Lock()
+	defer p.listenersRW.Unlock()
+	_, ok := p.listeners[k]
+	return ok
+}
