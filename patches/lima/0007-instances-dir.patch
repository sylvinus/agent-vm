 	limaDirList, err := os.ReadDir(limaDir)
 	if err != nil {
 		if errors.Is(err, os.ErrNotExist) {
@@ -69,6 +76,11 @@
 		if !f.IsDir() {
 			continue
 		}
+		if instancesDir != "" {
+			if st, err := os.Stat(filepath.Join(limaDir, f.Name(), dirnames.InstanceSubdir)); err != nil || !st.IsDir() {
+				continue
+			}
+		}
 		names = append(names, f.Name())
 	}
 	return names, nil
