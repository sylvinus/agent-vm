#!/usr/bin/env bash
#
# fs_suite.py against the rooted SFTP server of third_party/sshocker, through
# real sshfs, as the Lima hostagent serves agent-vm's shares.
#
#   tests/sftp/run [case-substring...]            the server agent-vm ships
#   tests/sftp/run --openssh [case-substring...]  OpenSSH's sftp-server, the control
#
# Needs Go, sshfs, fusermount (user_allow_other in /etc/fuse.conf) and
# python3. WORK (default /tmp/sftp-work) must be on this machine's
# own disk, never on a share served by the code under test.

set -euo pipefail

HERE="$(CDPATH= cd -P -- "$(dirname "${BASH_SOURCE[0]}")" >/dev/null && pwd)"
ROOT="$(CDPATH= cd -P -- "$HERE/../.." >/dev/null && pwd)"
WORK="${WORK:-/tmp/sftp-work}"

if [ "${1:-}" = --openssh ]; then
  shift
  harness="$HERE/openssh_harness.sh"
  run="$WORK/run-openssh"
else
  # The harness is added to agent-vm's module by an overlay, never written
  # into third_party/.
  mkdir -p "$WORK"
  cat > "$WORK/overlay.json" <<EOF
{"Replace": {
  "$ROOT/third_party/sshocker/pkg/reversesshfs/harness_export.go": "$HERE/testdata/harness/harness_export.go",
  "$ROOT/third_party/sshocker/cmd/harness/main.go": "$HERE/testdata/harness/main.go"
}}
EOF
  ( cd "$ROOT" && go build -overlay "$WORK/overlay.json" -o "$WORK/harness" ./third_party/sshocker/cmd/harness )
  harness="$WORK/harness"
  run="$WORK/run"
fi
exec python3 "$HERE/fs_suite.py" "$harness" "$run" "$@"
