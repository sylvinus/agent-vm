#!/usr/bin/env bash
#
# Rebuild third_party/<name> from its upstream commit (third_party/SOURCES)
# and patches/<name>/*.patch, applied in name order. The result is a package
# tree of agent-vm's module: its go.mod and go.sum are dropped and the import
# paths of the four trees rewritten to github.com/sylvinus/agent-vm/third_party/<name>,
# so that a program importing agent-vm builds them patched.
#
#   scripts/third-party-sync <name>|all               rewrite third_party/<name>
#   scripts/third-party-sync <name>|all --check       fail when third_party/<name> differs
#   scripts/third-party-sync <name> --ref <commit>    rebuild from <commit>, and record it
#
# A patch that does not apply stops it, with nothing changed: rebase that
# patch on the new upstream first. Edits made by hand in third_party/ are
# lost here and caught by --check (contents, executable bits and symbolic
# links): make them a patch instead.
#
# Rewriting a tree also raises the requirements of agent-vm's go.mod to its
# upstream go.mod's, then runs go mod tidy.
#
# Needs git, awk, find, diff, perl and, to rewrite third_party/<name>, rsync
# and go.

set -euo pipefail

ROOT="$(CDPATH= cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null && pwd)"
SOURCES="$ROOT/third_party/SOURCES"

die() { printf 'third-party-sync: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '5,7p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

[ $# -ge 1 ] || usage
target="$1"; shift
mode=write ref=""
while [ $# -gt 0 ]; do
  case "$1" in
    --check) mode=check ;;
    --ref)   [ $# -ge 2 ] || usage; ref="$2"; shift ;;
    *)       usage ;;
  esac
  shift
done
[ -z "$ref" ] || [ "$target" != all ] || die "--ref needs one name, not all"
[ -z "$ref" ] || [ "$mode" == write ] || die "--ref and --check do not go together"

names="$(awk '!/^#/ && NF { print $1 }' "$SOURCES")"
if [ "$target" != all ]; then
  printf '%s\n' "$names" | grep -qx -- "$target" || die "no '$target' in $SOURCES"
  names="$target"
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# The import paths of the four trees, upstream's to agent-vm's. Only the
# import lines (and the module path Lima's schema generator reads comments
# of) of .go files: the same string is also in comments, URLs, and in the
# protobuf descriptors of the .pb.go files, whose bytes are length-prefixed.
# A nested module (Lima's hack/tools) keeps its go.mod and stays out of
# agent-vm's.
rewrite_imports() {
  find "$1" -name '*.go' -type f -exec perl -pi -e '
    next unless m{^\s*(?:import\s+)?(?:[\w.]+\s+)?"github\.com/[^"]*"\s*$} || m{AddGoComments\("github\.com/};
    s{"github\.com/lima-vm/lima/v2(?![\w-])}{"github.com/sylvinus/agent-vm/third_party/lima}g;
    s{"github\.com/lima-vm/sshocker(?![\w-])}{"github.com/sylvinus/agent-vm/third_party/sshocker}g;
    s{"github\.com/pkg/sftp(?![\w-])}{"github.com/sylvinus/agent-vm/third_party/sftp}g;
    s{"github\.com/containers/gvisor-tap-vsock(?![\w-])}{"github.com/sylvinus/agent-vm/third_party/gvisor-tap-vsock}g;
  ' {} +
}

# AgentVMPatches in <name>: the number of the last patch applied, which the
# engine names: a tree without the patches does not compile against it. And
# AgentVMUpstream, the upstream version the tree is made from, for the
# programs that are not stamped with it at build time (-X).
patch_level() {
  local name="$1" dir="$2" upstream="$3" pkgdir last pkg
  case "$name" in
    lima)     pkgdir=pkg/version ;;
    sshocker) pkgdir=pkg/reversesshfs ;;
    sftp)     pkgdir=. ;;
    *)        pkgdir=pkg/types ;;
  esac
  last="$(ls "$ROOT/patches/$name" 2>/dev/null | awk -F- '/^[0-9]+-.*\.patch$/ { n = $1 + 0 } END { if (n) print n }')"
  [ -n "$last" ] || return 0
  pkg="$(awk '/^package / { print $2; exit }' "$dir/$pkgdir"/*.go 2>/dev/null | head -1)"
  [ -n "$pkg" ] || die "$name: no Go package in $pkgdir for AgentVMPatches"
  printf '// Code generated by scripts/third-party-sync. DO NOT EDIT.\n\npackage %s\n\n// AgentVMPatches is the last of agent-vm'"'"'s patches/%s in this tree.\nconst AgentVMPatches = "%s-%d"\n\n// AgentVMUpstream is the upstream version this tree is made from.\nconst AgentVMUpstream = "%s"\n' \
    "$pkg" "$name" "$name" "$last" "$upstream" > "$dir/$pkgdir/agentvm_patches.go"
}

# <name>: the upstream tree with the patches applied, in $TMP/<name>.
build() {
  local name="$1" url commit version omit p dir="$TMP/$1"
  read -r url commit version omit <<< "$(awk -v n="$name" '$1 == n { print $2, $3, $4, $5 }' "$SOURCES")"
  [ -z "$ref" ] || commit="$ref"
  git clone --quiet --filter=blob:none --no-checkout "$url" "$dir"
  git -C "$dir" -c advice.detachedHead=false checkout --quiet "$commit"
  commit="$(git -C "$dir" rev-parse HEAD)"
  version="$(git -C "$dir" describe --tags --match 'v[0-9]*' --always)"
  for p in "$ROOT/patches/$name"/*.patch; do
    [ -e "$p" ] || continue
    git -C "$dir" apply --whitespace=nowarn "$p" \
      || die "$name: ${p#"$ROOT"/} does not apply on $commit"
  done
  # Submodules (Lima's harnesses under hack/bats/lib) are never vendored:
  # the clone above leaves their folders empty, and empty folders cannot be
  # committed, so without this the check always differs.
  git -C "$dir" ls-files -s | awk '$1 == "160000" { sub(/^[^\t]*\t/, ""); print }' \
    | while IFS= read -r g; do rm -rf "${dir:?}/$g"; done
  find "$dir" -type d -empty -delete
  rm -rf "$dir/.git"
  cp "$dir/go.mod" "$TMP/$name.go.mod"
  rm -f "$dir/go.mod" "$dir/go.sum"
  rewrite_imports "$dir"
  patch_level "$name" "$dir" "$version"
  if [ "$omit" != - ]; then
    local o
    for o in ${omit//,/ }; do rm -rf "${dir:?}/$o"; done
  fi
  printf '%s %s\n' "$commit" "$version" > "$TMP/$name.commit"
}

# What diff -r does not see: the files that are executable, and the symbolic
# links (git records the one mode bit, and links as such).
shape() {
  ( cd "$1" && { find . -type f -perm -u+x -exec echo "x {}" \; ; find . -type l -exec echo "l {}" \; ; } | LC_ALL=C sort )
}

# The requirements of an upstream go.mod, raised in agent-vm's go.mod where
# they are higher (the minimal version selection a replace used to get).
raise_requirements() {
  local path version have
  while read -r path version; do
    case "$path" in
      github.com/lima-vm/lima/v2|github.com/lima-vm/sshocker|github.com/pkg/sftp|github.com/containers/gvisor-tap-vsock) continue ;;
    esac
    have="$(awk -v p="$path" '$1 == p { print $2 }' "$ROOT/go.mod" | head -1)"
    if [ -z "$have" ] || [ "$(printf '%s\n%s\n' "$have" "$version" | sort -V | head -1)" != "$version" ]; then
      ( cd "$ROOT" && go mod edit -require="$path@$version" )
    fi
  done < <(awk '
    /^require \(/ { inreq = 1; next }
    inreq && /^\)/ { inreq = 0; next }
    inreq && NF >= 2 && $1 !~ /^\/\// { print $1, $2 }
    /^require [^(]/ { print $2, $3 }' "$1")
}

st=0
for name in $names; do
  build "$name"
  if [ "$mode" == check ]; then
    if diff -r -q "$TMP/$name" "$ROOT/third_party/$name" >&2 \
       && diff <(shape "$TMP/$name") <(shape "$ROOT/third_party/$name") >&2; then
      printf 'third_party/%s: upstream and patches, unchanged\n' "$name"
    else
      printf 'third_party/%s: differs from upstream and patches (above)\n' "$name" >&2
      st=1
    fi
    continue
  fi
  rsync -a --no-owner --no-group --delete "$TMP/$name/" "$ROOT/third_party/$name/"
  read -r commit version < "$TMP/$name.commit"
  awk -v n="$name" -v c="$commit" -v v="$version" '
    $1 == n && !/^#/ { $0 = sprintf("%-10s %-41s %-41s %-27s %s", $1, $2, c, v, $5) }
    { print }' \
    "$SOURCES" > "$TMP/SOURCES" && cat "$TMP/SOURCES" > "$SOURCES"
  raise_requirements "$TMP/$name.go.mod"
  printf 'third_party/%s: rebuilt (%s)\n' "$name" "$version"
done
if [ "$mode" == write ]; then
  ( cd "$ROOT" && go mod tidy )
fi
exit "$st"
