#!/usr/bin/env bash
#
# THIRD_PARTY_LICENSES: the license and notice files of every module and of Go
# itself that the release binaries are built from.
#
#   scripts/licenses            rewrite THIRD_PARTY_LICENSES
#   scripts/licenses --check    fail when it is out of date
#
# The modules are those of `go list -deps` for the binary on Linux, macOS and
# Windows and for the guest agent embedded in it, with the Makefile's tags.
# Needs go and a module cache (go mod download). Run it again after a change
# of go.mod or third_party/.

set -euo pipefail

ROOT="$(CDPATH= cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null && pwd)"
OUT="$ROOT/THIRD_PARTY_LICENSES"
cd "$ROOT"

check=""
case "${1:-}" in
  "") ;;
  --check) check=1 ;;
  *) sed -n '5,6p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac

tags="$(awk '$1 == "TAGS" && $2 == ":=" { print $3 }' Makefile)"
[ -n "$tags" ] || { echo "licenses: no TAGS in the Makefile" >&2; exit 1; }

# <path> <version> <dir> per module, for one target.
modules() {  # <goos> <goarch> <cgo> <package>
  GOOS="$1" GOARCH="$2" CGO_ENABLED="$3" GOWORK=off go list -deps -tags "$tags" \
    -f '{{with .Module}}{{if not .Main}}{{.Path}} {{with .Replace}}{{.Path}}{{else}}{{.Version}}{{end}} {{.Dir}}{{end}}{{end}}' "$4"
}

# Modules only the macOS or Windows builds use are not in a cache filled by a
# Linux build.
GOWORK=off go mod download

list="$(mktemp)"
trap 'rm -f "$list"' EXIT
{
  modules linux amd64 0 ./cmd/agent-vm
  modules linux arm64 0 ./cmd/agent-vm
  modules darwin arm64 1 ./cmd/agent-vm
  modules darwin amd64 1 ./cmd/agent-vm
  modules windows amd64 0 ./cmd/agent-vm
  modules windows arm64 0 ./cmd/agent-vm
  modules linux arm64 0 ./third_party/lima/cmd/lima-guestagent
  modules linux amd64 0 ./third_party/lima/cmd/lima-guestagent
  # Packages of the main module, with licenses of their own: listed under
  # their upstream names.
  echo "github.com/lima-vm/lima/v2 ./third_party/lima $ROOT/third_party/lima"
  echo "github.com/lima-vm/sshocker ./third_party/sshocker $ROOT/third_party/sshocker"
  echo "github.com/pkg/sftp ./third_party/sftp $ROOT/third_party/sftp"
  echo "github.com/containers/gvisor-tap-vsock ./third_party/gvisor-tap-vsock $ROOT/third_party/gvisor-tap-vsock"
} | awk 'NF == 3 && !seen[$1]++' | LC_ALL=C sort > "$list"

[ -s "$list" ] || { echo "licenses: go list found no module" >&2; exit 1; }

render() {
  cat <<'EOF'
Third-party licenses

agent-vm is MIT licensed (LICENSE). The binary is built from the modules
below and from Go's standard library. Each section gives a module, its
version and the license and notice files at the root of its source, verbatim.
third_party/ holds Lima, sshocker, pkg/sftp and gvisor-tap-vsock as upstream
plus patches/ (see NOTICE).

Generated by scripts/licenses.

EOF
  printf '================================================================================\n'
  printf 'Go standard library (BSD-3-Clause)\n'
  printf '================================================================================\n\n'
  cat "$(go env GOROOT)/LICENSE"
  printf '\n'
  while read -r path version dir; do
    found=0
    # LICENSE, LICENCE, COPYING, NOTICE, UNLICENSE, PATENTS, with any suffix.
    while IFS= read -r f; do
      found=1
      printf '================================================================================\n'
      printf '%s %s: %s\n' "$path" "${version:-}" "$(basename "$f")"
      printf '================================================================================\n\n'
      cat "$f"
      printf '\n'
    done < <(find "$dir" -maxdepth 1 -type f \( -iname 'licen[sc]e*' -o -iname 'copying*' -o -iname 'notice*' -o -iname 'unlicense*' -o -iname 'patents*' \) | LC_ALL=C sort)
    if [ "$found" = 0 ]; then
      echo "licenses: no license file in $path $version ($dir)" >&2
      return 1
    fi
  done < "$list"
}

tmp="$(mktemp)"
trap 'rm -f "$list" "$tmp"' EXIT
render > "$tmp"

if [ -n "$check" ]; then
  if cmp -s "$tmp" "$OUT"; then
    echo "THIRD_PARTY_LICENSES is up to date"
  else
    echo "THIRD_PARTY_LICENSES is out of date: run scripts/licenses" >&2
    diff "$OUT" "$tmp" | head -20 >&2 || true
    exit 1
  fi
else
  cat "$tmp" > "$OUT"
  echo "THIRD_PARTY_LICENSES: $(wc -l < "$list" | tr -d ' ') modules"
fi
